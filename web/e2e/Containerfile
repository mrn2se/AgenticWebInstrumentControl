# Headless Chromium for the UI smoke test (make e2e). Layout bugs — a module
# that stays visible when hidden, a plot that grows without bound — are
# invisible to unit tests: jsdom computes no layout. This renders the real
# page in a real browser.
FROM node:26-trixie-slim
RUN npm install -g playwright@1.63 >/dev/null 2>&1 \
 && npx playwright install --with-deps chromium >/dev/null 2>&1
ENV NODE_PATH=/usr/local/lib/node_modules
WORKDIR /e2e
